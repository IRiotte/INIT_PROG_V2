<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<Scene xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <AnchorPane prefHeight="200.0" prefWidth="200.0">
      <children>
         <VBox layoutX="-2.0" prefHeight="262.0" prefWidth="302.0">
            <children>
               <Label fx:id="labelTitre" alignment="CENTER" prefHeight="100.0" prefWidth="310.0" text="Jeu du Puissance 4" textOverrun="CLIP" />
               <Label fx:id="labelSelectJoueur" alignment="CENTER" prefHeight="27.0" prefWidth="302.0" text="Sélectionner le nombre de joueurs" />
               <HBox prefHeight="49.0" prefWidth="302.0">
                  <children>
                     <Button fx:id="boutonJoueur1" mnemonicParsing="false" prefHeight="106.0" prefWidth="148.0" text="1 Joueur" />
                     <Button fx:id="boutonJoueur2" mnemonicParsing="false" prefHeight="106.0" prefWidth="153.0" text="2 Joueur" />
                  </children>
               </HBox>
            </children>
         </VBox>
      </children></AnchorPane>
</Scene>
